<?xml version="1.0"?>
<ruleset name="CoCart Coding Standards">
	<description>CoCart Code Standards</description>

	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern type="relative">node_modules/*</exclude-pattern>
	<exclude-pattern type="relative">vendor/*</exclude-pattern>
	<exclude-pattern type="relative">tests/*</exclude-pattern>
	<exclude-pattern>Gruntfile.js</exclude-pattern>

	<!-- Enable colors in report -->
	<arg name="colors"/>

	<!-- Show progress, show the error codes for each message (source). -->
	<arg value="ps" />

	<!-- Strip the filepaths in reports down to the relevant bit. -->
	<arg name="basepath" value="./" />

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8" />

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Configs -->
	<config name="minimum_supported_wp_version" value="6.3" />
	<config name="testVersion" value="8.2-" />

	<!-- Rules -->
	<rule ref="CoCart-Core">
		<exclude name="Core.Commenting.CommentTags.AuthorTag" />
		<exclude name="WordPress.PHP.DontExtract" />
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cart-rest-api-for-woocommerce"/>
				<element value="cocart-core"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>languages/</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>includes/compatibility/modules/*.php</exclude-pattern>
		<exclude-pattern>includes/third-party/**/**/*.php</exclude-pattern>
		<exclude-pattern>includes/third-party/**/*.php</exclude-pattern>
		<exclude-pattern>includes/*.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.PHP.StrictInArray.MissingTrueStrict">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.PHP.PregQuoteDelimiter.Missing">
		<severity>0</severity>
	</rule>

	<rule ref="PHPCompatibility">
		<include-pattern>*\.php$</include-pattern>
		<exclude-pattern>tests/</exclude-pattern>
	</rule>

	<rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
		<severity>0</severity>
	</rule>

	<!-- ==================================================================== -->
	<!-- ARCHITECTURAL RULE EXCLUSIONS -->
	<!-- The following rules are excluded for legitimate architectural reasons -->
	<!-- ==================================================================== -->

	<!-- Direct database queries for custom cocart_carts table -->
	<!-- CoCart maintains its own cart storage table with properly prepared queries -->
	<!-- This is necessary for session management and cart persistence -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>includes/cocart-background-functions.php</exclude-pattern>
		<exclude-pattern>includes/cocart-core-functions.php</exclude-pattern>
		<exclude-pattern>includes/classes/class-cocart-session-handler.php</exclude-pattern>
		<exclude-pattern>includes/classes/class-cocart-install.php</exclude-pattern>
		<exclude-pattern>includes/classes/utilities/class-cocart-utilities-cache-helpers.php</exclude-pattern>
		<exclude-pattern>includes/classes/rest-api/controllers/v2/admin/*-session*.php</exclude-pattern>
	</rule>

	<!-- REST API authentication uses token-based auth (Bearer, Basic Auth, OAuth) instead of nonces -->
	<!-- SECURITY NOTE: Only applies to REST authentication layers, NOT admin forms or pages -->
	<rule ref="WordPress.Security.NonceVerification.Recommended">
		<exclude-pattern>includes/classes/rest-api/class-cocart-authentication.php</exclude-pattern>
		<exclude-pattern>includes/classes/rest-api/controllers/v2/others/class-cocart-login-controller.php</exclude-pattern>
	</rule>

	<!-- Template view files use unprefixed local variables for readability -->
	<!-- These variables are locally scoped within included templates and don't pollute global scope -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>includes/classes/admin/views/*.php</exclude-pattern>
	</rule>

	<!-- CoCart uses hyphens in dynamic hook names to match REST API endpoint naming patterns -->
	<!-- Example: cocart_get_customer_{$field} where field can be "billing-email" -->
	<rule ref="WordPress.NamingConventions.ValidHookName.UseUnderscores">
		<exclude-pattern>includes/classes/utilities/class-cocart-utilities-cart-helpers.php</exclude-pattern>
		<exclude-pattern>includes/classes/rest-api/class-cocart-response.php</exclude-pattern>
	</rule>

	<!-- REST API product endpoints require exclude parameter for client-side filtering -->
	<!-- This is a legitimate REST API feature for product queries -->
	<rule ref="WordPressVIPMinimum.Performance.WPQueryParams.PostNotIn_exclude">
		<exclude-pattern>includes/classes/rest-api/controllers/class-cocart-products-controller.php</exclude-pattern>
		<exclude-pattern>includes/classes/rest-api/controllers/class-cocart-taxonomy-terms-controller.php</exclude-pattern>
		<exclude-pattern>includes/classes/rest-api/controllers/v2/products/*.php</exclude-pattern>
	</rule>
</ruleset>
